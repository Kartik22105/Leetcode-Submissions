class Solution {
    public int sumCounts(List<Integer> nums) {
        int sum = 0;
        for(int i=0;i<nums.size();i++){
            HashSet<Integer> set = new HashSet<>();
            for(int j=i;j<nums.size();j++){
                for(int k=i;k<=j;k++){
                    set.add(nums.get(k));
                }
                int n = set.size();
                sum += (n*n);
            }

        }
        return sum;
    }
}
